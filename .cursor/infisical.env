# Per-repo committed non-secrets for Cursor Cloud sessions on DealDex.
# Cursor dashboard injects INFISICAL_CLIENT_ID and INFISICAL_CLIENT_SECRET at
# start time; everything the app depends on lives in the Infisical project
# keyed here.  Never put credentials, tokens, or secret VALUES in this file.
INFISICAL_PROJECT_ID=6d50da37-5fb9-4c5b-bcf0-085ac29c1705
INFISICAL_ENV=dev
INFISICAL_DOMAIN=https://app.infisical.com