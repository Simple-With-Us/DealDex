# DealDex .env.example — local dev overrides (names only, never real values)
#
# Infisical is the sole source of truth for app-level settings (see INFISICAL.md).
# These entries exist for local dev / CI without the machine identity
# (local-only mode): copy to .env and fill in.  Never commit a real .env.
#
# When the server has INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET, values in
# the DealDex Infisical project win over these.

# --- Machine identity for the settings layer (keep in the secret store, not here in prod) ---
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# DEALDEX_INFISICAL_ENV=dev        # dev | staging | prod (default: VERCEL_ENV mapping)

# --- App secrets (admin fills in Infisical; empty here) ---
DATABASE_URL=
BETTER_AUTH_SECRET=
SCAN_RUNNER_TOKEN=
PROXY_URL_LIST=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# or: APPLE_TEAM_ID= / APPLE_KEY_ID= / APPLE_PRIVATE_KEY=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
EBAY_APP_ID=
EBAY_CERT_ID=

# --- Env config ---
BETTER_AUTH_URL=
EBAY_REDIRECT_URI=
EBAY_ENV=production
SENTRY_DSN=
SENTRY_ENV=
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Tunable knobs (defaults shown; Infisical overrides without a deploy) ---
SETTINGS_REFRESH_INTERVAL_MS=300000
SCAN_MAX_ROWS_PER_RUN=50
PROXY_MAX_CONCURRENCY=4
AUTO_BUY_DRY_RUN_FORCE=false
AUTO_BUY_DEFAULT_MIN_SPREAD=0.18
AUTO_BUY_DEFAULT_MAX_PRICE_CENTS=5000
AUTO_BUY_DEFAULT_MAX_DAILY_CENTS=10000
AUTO_BUY_DEFAULT_MAX_MONTHLY_CENTS=50000
AUTO_BUY_DEFAULT_COOL_HOURS=24

# --- Build-time client env (VITE_* — baked into the client bundle, not Infisical-managed) ---
# VITE_AUTH_ENABLED=
# VITE_PUBLIC_HOSTNAME=
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=
